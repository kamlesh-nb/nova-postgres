// connection: PostgreSQL connection-string parsing (SRP: connection string only).
// `postgresql://user[:password]@host[:port]/database?sslmode=...&sslrootcert=...`
// Pure string work; no I/O, no db seam. The seam (postgres.nova) turns a ConnectionOptions into a
// live connection.
import string;

pub struct ConnectionOptions {
    pub host: string,
    pub port: int,
    pub user: string,
    pub password: string,
    pub database: string,
    pub sslmode: string,       // "disable" (default) | "require" | "verify-full"
    pub sslrootcert: string,   // path to a PEM CA bundle (verify-full)
    init(host: string, port: int, user: string, password: string, database: string, sslmode: string, sslrootcert: string) {
        self.host = host; self.port = port; self.user = user;
        self.password = password; self.database = database;
        self.sslmode = sslmode; self.sslrootcert = sslrootcert;
    }
}

// Pull `key=value` out of a `?a=b&c=d` connection string query string (returns `dflt` if absent).
fn queryParam(connectionString: string, key: string, dflt: string): string {
    let needle = key + "=";
    let idx = string.indexOf(connectionString, needle);
    if (idx == -1) { return dflt; }
    let start = idx + needle.length;
    let rest = string.slice(connectionString, start, connectionString.length);
    let amp = string.indexOf(rest, "&");
    if (amp == -1) { return rest; }
    return string.slice(rest, 0, amp);
}

// postgresql://user[:password]@host[:port]/database   (scheme optional; sane defaults)
pub fn parse(connectionString: string): ConnectionOptions {
    let sslmode = queryParam(connectionString, "sslmode", "disable");
    let sslrootcert = queryParam(connectionString, "sslrootcert", "");

    let s = connectionString;
    let scheme = string.indexOf(s, "://");
    if (scheme != -1) { s = string.slice(s, scheme + 3, s.length); }
    // Drop the `?query` so it does not leak into the database/host parse.
    let q = string.indexOf(s, "?");
    if (q != -1) { s = string.slice(s, 0, q); }

    let user = "postgres";
    let password = "";
    let at = string.lastIndexOf(s, "@");
    if (at != -1) {
        let cred = string.slice(s, 0, at);
        s = string.slice(s, at + 1, s.length);
        let colon = string.indexOf(cred, ":");
        if (colon == -1) {
            user = cred;
        } else {
            user = string.slice(cred, 0, colon);
            password = string.slice(cred, colon + 1, cred.length);
        }
    }

    let database = user;
    let slash = string.indexOf(s, "/");
    if (slash != -1) {
        database = string.slice(s, slash + 1, s.length);
        s = string.slice(s, 0, slash);
    }

    let host = s;
    let port = 5432;
    let pc = string.lastIndexOf(s, ":");
    if (pc != -1) {
        host = string.slice(s, 0, pc);
        port = string.parseI64(string.slice(s, pc + 1, s.length));
    }
    return ConnectionOptions(host, port, user, password, database, sslmode, sslrootcert);
}
