// postgres.nova — the PostgreSQL driver SEAM: PgConnection (impl db.Connection) and
// PgDriver (impl db.Driver). This module orchestrates the connection lifecycle + the
// request/response loops; every other responsibility lives in its own module (SOLID/SRP):
//
//   connection      connection-string parsing        (ConnectionOptions, parse)
//   codec    the v3 wire codec                (build* frames + decode* responses, PgCursor)
//   typemap  OID<->DbType + value<->SQL/bind  (oidToDbType, decodeCell, substituteParams)
//   proto    async transport framing          (PgReader, PgFrame, readFrame, sendFrame)
//   stmt     prepared-statement cache entry   (PgStmt)
//   auth     the SCRAM/cleartext auth exchange (newScramClient, handleAuth)
//
// PgConnection/PgDriver are the only names consumers touch: `import postgres; PgDriver()`.
//
//   let drv = PgDriver();
//   let conn = drv.connect("postgresql://user@127.0.0.1:5432/mydb");
//   let rs = conn.query("SELECT id, name FROM users", List<DbValue>());
//   let id = rs.row(0).getInt(0);   // typed
//
// The pure halves (codec/typemap) are offline-gated; connect/query wire them to a
// TcpStream and are live-verified against a running PostgreSQL.
import net.aio;
import net.asynctls;
import io.file;
import bytes;
import string;
import list;
import db;
import connection;
import codec;
import typemap;
import proto;
import stmt;
import auth;

// --- The seam implementation --------------------------------------------------

pub struct PgConnection impl Connection {
    pub io: aio.AsyncIO,
    pub reader: PgReader,
    pub stmts: List<PgStmt>,     // per-connection prepared-statement cache
    pub host: string,            // for CancelRequest (opens a SIDE connection to the same server)
    pub port: int,
    pub pid: int,                // BackendKeyData: process id + secret, needed to cancel this session
    pub secret: int,
    pub busy: bool,              // concurrency guard: one in-flight request per connection
    pub notes: List<PgNotification>,  // async NOTIFYs captured off the wire during query/exec
    init(io: aio.AsyncIO, reader: PgReader, host: string, port: int, pid: int, secret: int) {
        self.io = io;
        self.reader = reader;
        self.stmts = List<PgStmt>();
        self.host = host;
        self.port = port;
        self.pid = pid;
        self.secret = secret;
        self.busy = false;
        self.notes = List<PgNotification>();
    }

    pub async fn query(self, sql: string, params: List<DbValue>): ResultSet {
        // A connection is a single request/response channel; a second concurrent query would interleave
        // frames and corrupt the stream. Refuse re-entry instead (use a pool for concurrency).
        if (self.busy) { return db.errorResult(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sn = await proto.sendFrame(self.io, codec.buildQuery(typemap.substituteParams(sql, params)));
        let rs = ResultSet();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }                                    // 'Z' ReadyForQuery
            if (f.ftype == 84) { rs.columns = codec.decodeRowDesc(f.payload); }    // 'T'
            if (f.ftype == 68) { rs.rows.push(codec.decodeDataRow(f.payload, rs.columns)); } // 'D'
            if (f.ftype == 67) {                                             // 'C'
                rs.tag = codec.decodeTag(f.payload);
                rs.rows_affected = codec.tagCount(rs.tag);
            }
            if (f.ftype == 69) { rs.err = codec.decodeError(f.payload); }          // 'E' ErrorResponse
            if (f.ftype == 65) { self.notes.push(codec.decodeNotification(f.payload)); } // 'A' NotificationResponse
        }
        self.busy = false;
        return rs;
    }

    pub async fn exec(self, sql: string, params: List<DbValue>): ExecResult {
        if (self.busy) { return errorExec(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sn = await proto.sendFrame(self.io, codec.buildQuery(typemap.substituteParams(sql, params)));
        let tag = "";
        let err = noError();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }
            if (f.ftype == 67) { tag = codec.decodeTag(f.payload); }
            if (f.ftype == 69) { err = codec.decodeError(f.payload); }             // 'E' ErrorResponse
            if (f.ftype == 65) { self.notes.push(codec.decodeNotification(f.payload)); } // 'A' NotificationResponse
        }
        self.busy = false;
        if (!err.isEmpty()) { return errorExec(err); }
        return ExecResult(codec.tagCount(tag), tag);
    }

    pub fn close(self): void {
        // Sync trait method — just close the socket. A graceful Terminate would need an async send,
        // which cannot be driven here: close is often called from INSIDE a coroutine (e.g. to cancel
        // a timed-out query and drain its future), where a nested drive would deadlock nova_run_root.
        // An abrupt close is fine — the server tears the connection down.
        self.io.close();
    }

    pub fn setTimeout(self, ms: int): int {   // async per-recv awaited deadline
        return self.io.setTimeout(ms);
    }

    // Prepared statements (real server-side extended query). Parse + Describe the SQL once,
    // cache the assigned name + RowDescription columns, and reuse across executions — the server
    // parses/plans a given SQL a single time. Deduplicated: preparing the same SQL again returns
    // the existing handle with no round-trip.
    pub async fn prepare(self, sql: string): int {
        let i = 0;
        while (i < self.stmts.size()) {
            let s = self.stmts.get(i) ?? PgStmt("", "", List<Column>());
            if (string.eql(s.sql, sql)) { return i; }
            i = i + 1;
        }
        let idx = self.stmts.size();
        let name = `nova_s${idx}`;
        let s1 = await proto.sendFrame(self.io, codec.buildParse(name, sql));
        let s2 = await proto.sendFrame(self.io, codec.buildDescribeStmt(name));
        let s3 = await proto.sendFrame(self.io, codec.buildSync());
        let cols = List<Column>();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }                          // 'Z' ReadyForQuery
            if (f.ftype == 84) { cols = codec.decodeRowDesc(f.payload); } // 'T' RowDescription
            // 'E' ErrorResponse: keep draining to 'Z' so the stream stays in sync (prepare returns an
            // int handle and has no error channel yet; query/exec surface the DbError).
            // '1' ParseComplete / 't' ParameterDescription / 'n' NoData — nothing to capture.
        }
        self.stmts.push(PgStmt(name, sql, cols));
        return idx;
    }

    pub async fn queryPrepared(self, stmt: int, params: List<DbValue>): ResultSet {
        let rs = ResultSet();
        if (stmt < 0 || stmt >= self.stmts.size()) { return rs; }
        let s = self.stmts.get(stmt) ?? PgStmt("", "", List<Column>());
        rs.columns = codec.copyColumns(s.cols);      // Execute won't resend RowDescription
        let s1 = await proto.sendFrame(self.io, codec.buildBind("", s.name, params));
        let s2 = await proto.sendFrame(self.io, codec.buildExecute("", 0));
        let s3 = await proto.sendFrame(self.io, codec.buildSync());
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }                                            // 'Z'
            if (f.ftype == 68) { rs.rows.push(codec.decodeDataRow(f.payload, rs.columns)); } // 'D'
            if (f.ftype == 67) {                                                      // 'C'
                rs.tag = codec.decodeTag(f.payload);
                rs.rows_affected = codec.tagCount(rs.tag);
            }
            if (f.ftype == 69) { rs.err = codec.decodeError(f.payload); }                   // 'E' -- drain to 'Z'
            // '2' BindComplete — nothing to do.
        }
        return rs;
    }

    pub async fn execPrepared(self, stmt: int, params: List<DbValue>): ExecResult {
        if (stmt < 0 || stmt >= self.stmts.size()) { return ExecResult(0, ""); }
        let s = self.stmts.get(stmt) ?? PgStmt("", "", List<Column>());
        let s1 = await proto.sendFrame(self.io, codec.buildBind("", s.name, params));
        let s2 = await proto.sendFrame(self.io, codec.buildExecute("", 0));
        let s3 = await proto.sendFrame(self.io, codec.buildSync());
        let tag = "";
        let err = noError();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }               // 'Z'
            if (f.ftype == 67) { tag = codec.decodeTag(f.payload); }
            if (f.ftype == 69) { err = codec.decodeError(f.payload); }   // 'E' -- drain to 'Z'
        }
        if (!err.isEmpty()) { return errorExec(err); }
        return ExecResult(codec.tagCount(tag), tag);
    }

    // Transaction control (standard SQL). exec already surfaces a DbError via .err on failure.
    pub async fn begin(self): ExecResult { return await self.exec("BEGIN", List<DbValue>()); }
    pub async fn commit(self): ExecResult { return await self.exec("COMMIT", List<DbValue>()); }
    pub async fn rollback(self): ExecResult { return await self.exec("ROLLBACK", List<DbValue>()); }

    // --- LISTEN/NOTIFY --------------------------------------------------------
    // Register interest in a channel. Runs `LISTEN <channel>` via the normal exec path (the
    // server replies CommandComplete); subsequent NOTIFYs arrive as async 'A' frames, which the
    // query/exec read loops capture into `self.notes`. Drain them with `notifications()`.
    pub async fn listen(self, channel: string): ExecResult {
        return await self.exec("LISTEN " + channel, List<DbValue>());
    }
    // Drain the notifications buffered off the wire so far (captured during any query/exec on this
    // connection) and reset the buffer. NOTE: this returns what has ALREADY been read; a dedicated
    // idle delivery loop that blocks awaiting the next 'A' with no query in flight is the follow-on.
    pub fn notifications(self): List<PgNotification> {
        let out = self.notes;
        self.notes = List<PgNotification>();
        return out;
    }

    // --- COPY OUT -------------------------------------------------------------
    // Run `COPY ... TO STDOUT` and collect each 'd' CopyData chunk as a string until 'c' CopyDone,
    // then drain 'C' CommandComplete / 'Z' ReadyForQuery. The offline gate exercises the pure
    // decoders (decodeCopyResponse / decodeCopyData); this wires them to the live stream.
    pub async fn copyOut(self, sql: string): List<string> {
        let chunks = List<string>();
        if (self.busy) { return chunks; }
        self.busy = true;
        let sn = await proto.sendFrame(self.io, codec.buildQuery(sql));
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }                              // 'Z' ReadyForQuery
            if (f.ftype == 100) { chunks.push(codec.decodeCopyData(f.payload)); } // 'd' CopyData
            // 'H'(72) CopyOutResponse header, 'c'(99) CopyDone, 'C'(67) CommandComplete — nothing to collect.
            if (f.ftype == 65) { self.notes.push(codec.decodeNotification(f.payload)); } // 'A'
        }
        self.busy = false;
        return chunks;
    }

    // Cancel the query currently running on THIS session. Postgres requires this on a fresh connection
    // (the running connection is busy), authenticated only by the (pid, secret) captured at handshake.
    // Call from a different coroutine while a query on this connection is in flight (e.g. on a deadline).
    pub async fn cancel(self): void {
        if (self.pid == 0) { return; }        // no BackendKeyData -> cannot cancel
        let side = await aio.asyncConnect(self.host, self.port);
        let _ = await side.sendStr(codec.buildCancelRequest(self.pid, self.secret));
        side.close();
    }
}

/// The PostgreSQL driver. connection string: `postgresql://user@host:port/database` (password optional
/// as `user:password@`). Handles the startup handshake incl. AuthenticationOk / Cleartext /
/// SCRAM-SHA-256, then reads ParameterStatus/BackendKeyData until ReadyForQuery.
// The whole connect + startup handshake as ONE async fn (one await-chain, driven once by the
// synchronous Driver.connect). Every socket op parks the coroutine; a single drive pumps the
// asio io_context through the entire handshake.
async fn pgConnectAsync(connectionString: string): PgConnection {
    let d = connection.parse(connectionString);
    let base = await aio.asyncConnect(d.host, d.port);

    // sslmode=disable (default): plaintext, unchanged path.
    if (string.eql(d.sslmode, "disable")) {
        return await pgStartup(base, d);
    }

    // STARTTLS: send SSLRequest and read the single-byte reply ('S' supported / 'N' refused).
    let _sr = await base.sendStr(codec.buildSSLRequest());
    let rb = bytes.alloc(1);
    let rn = await base.recvInto(rb as long, 1);
    let sslByte = if (rn > 0) bytes.read_byte(rb, 0) else 0;
    bytes.free(rb);

    if (sslByte == 83) {   // 'S' — upgrade this socket to TLS
        if (string.eql(d.sslmode, "verify-full")) {
            let caPem = if (d.sslrootcert != "") File.readText(d.sslrootcert) else "";
            let ts = await asynctls.tlsClientUpgradeVerify(base, d.host, caPem);
            return await pgStartup(ts, d);
        }
        let ts2 = await asynctls.tlsClientUpgrade(base, d.host);
        return await pgStartup(ts2, d);
    }
    // 'N': server refused TLS. Best-effort fallback to plaintext for now; fail-closed enforcement
    // (require/verify-full MUST NOT continue unencrypted) needs the connect error channel (T1 residual).
    return await pgStartup(base, d);
}

// Run the Postgres startup + auth handshake over `io` (plaintext AsyncStream or an upgraded TlsStream,
// both AsyncIO). Passing the concrete stream into this AsyncIO param is a widening, the safe direction.
async fn pgStartup(io: aio.AsyncIO, d: ConnectionOptions): PgConnection {
    let reader = PgReader(io);
    let sn = await proto.sendFrame(io, codec.buildStartup(d.user, d.database));

    // A SCRAM-SHA-256 exchange spans several 'R' messages, so the ScramClient (holding
    // username/password/client-nonce) lives across the loop. Auth-mechanism detail is in auth.
    let scram = auth.newScramClient(d.user, d.password);

    let pid = 0;
    let secret = 0;
    while (true) {
        let f = await proto.readFrame(reader);
        if (f.ftype == -1) { break; }
        if (f.ftype == 90) { break; }   // 'Z' ReadyForQuery — handshake done
        if (f.ftype == 75) {            // 'K' BackendKeyData: capture pid + secret for CancelRequest
            let kc = codec.PgCursor(f.payload);
            pid = kc.i32();
            secret = kc.i32();
        }
        if (f.ftype == 82) {            // 'R' Authentication — delegate to auth
            await auth.handleAuth(io, f.payload, d.password, scram);
        }
        if (f.ftype == 69) {            // 'E' ErrorResponse during startup
            break;
        }
    }
    return PgConnection(io, reader, d.host, d.port, pid, secret);
}

pub struct PgDriver impl Driver {
    pub async fn connect(self, connectionString: string): Connection {
        // connect is a synchronous trait method: it DRIVES the async connect + handshake to
        // completion (a one-time setup cost, one drive). The resulting connection's query/exec
        // are async and PARK — that is where the non-blocking benefit lands.
        return await pgConnectAsync(connectionString);
    }
}
